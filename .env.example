# Лише локальний сервер: npm run auth-server
# GitHub Pages цей файл не читає. Mini App на сайті працює без цих змінних.
# Токен лише на сервері. Ніколи не кладіть його в src/ або у фронтенд.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLUB_CHAT_ID=
BOT_API_SECRET=
# Якщо задано, POST /api/club-data приймає лише заголовок X-Club-Key з цим значенням
# (або перевірений initData тренера, коли задано TELEGRAM_BOT_TOKEN).
CLUB_WRITE_SECRET=
# CLUB_DATA_FILE=./data/club-data.json
PORT=8787
# Локально можна поставити *. На публічному сервері вкажи точний адрес Mini App.
# Порожня змінна в коді теж відкриває CORS для всіх. Це лише для розробки.
CORS_ORIGIN=http://127.0.0.1:8787
INITDATA_MAX_AGE_SEC=86400
