# Клубний бот. Токен лише на сервері — ніколи не кладіть його в src/ або у фронтенд.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLUB_CHAT_ID=
BOT_API_SECRET=
# Якщо задано, POST /api/club-data приймає лише заголовок X-Club-Key з цим значенням
# (або перевірений initData тренера, коли задано TELEGRAM_BOT_TOKEN).
CLUB_WRITE_SECRET=
